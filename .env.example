# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）

# ===== 阿里云百炼（对话 + 向量模型）=====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=
DASHSCOPE_EMBEDDINGS=

# ===== 高德地图 =====
AMAP_API_KEY=

# ===== 天气 =====
WEATHER_API_KEY=

# ===== 数据库路径（相对 backend/ 目录）=====
CHROMA_DB_PATH=./data/chroma_db
CHECKPOINT_DB_PATH=./data/checkpoints/sessions.db

# ===== CORS =====
ALLOWED_ORIGINS=["http://localhost:5173"]

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== MCP 工具运行时 uvx 的绝对路径（留空则自动探测 PATH 与当前虚拟环境）=====
UVX_PATH=

# ===== 景点地理编码失败时的坐标兜底中心 =====
DEFAULT_MAP_LNG=121.6186
DEFAULT_MAP_LAT=38.9146
