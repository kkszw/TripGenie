# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）

# ===== DeepSeek（对话模型）=====
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-flash（快/便宜）| deepseek-v4-pro（强/贵）
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled | enabled。默认 disabled，原因见 core/agents.py 注释
DEEPSEEK_THINKING=disabled
# 单价（元 / 百万 token），用于把 runs.jsonl 里的 token 折成钱。
# 填的是高峰时段价；空闲时段（工作日 9-12、14-18 之外，含周末）自动乘 0.5。
# 输入必须分「缓存命中 / 未命中」，两者差 50 倍，只配一个数会把成本高估几倍。
DEEPSEEK_INPUT_PRICE=2.0
DEEPSEEK_OUTPUT_PRICE=8.0
DEEPSEEK_CACHE_HIT_PRICE=0.04
DEEPSEEK_OFFPEAK_RATIO=0.5

# ===== 阿里云百炼（仅用于 RAG 向量化，DeepSeek 没有 embedding 接口）=====
# 不填 EMBEDDING_API_KEY 时自动复用 DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

# 默认 text-embedding-v4（1024 维，按量计费）。
# 曾用 qwen3.7-text-embedding-flash，其免费额度用尽后会持续返回 400，不适合全量建库。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选 256 / 512 / 768 / 1024；改了必须重建向量库
EMBEDDING_DIMENSIONS=1024
# 单次请求文本条数上限。v4/v3 是 10，老 flash 模型是 20，取 10 两者通用
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=30
# collection 名带上模型标识，换模型时同步改，避免新老向量混在同一个库
EMBEDDING_COLLECTION=trip_guides_v4

# ===== 检索 =====
# 混合检索：向量召回 + BM25 关键词召回，用 RRF 融合。
# 关掉就退回纯向量。BM25 索引在首次检索时自动建（约 10 秒）并缓存到
# app/data/cache/，之后启动只加载不重建。
HYBRID_SEARCH=true

# ===== LLM 调用超时（秒）=====
LLM_TIMEOUT=120

# ===== 登录认证 =====
# 令牌签名密钥。必须固定，换了等于让所有人退出登录。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# 令牌有效期（天）
JWT_EXPIRE_DAYS=7

# ===== 高德地图 =====
# key 必须是「Web服务」类型，JS API / 小程序 key 会返回 INVALID_USER_KEY
AMAP_API_KEY=
# 折线抽稀容差（米）：被删点偏离保留折线不超过它，路径形状不变。设 0 关闭
MAP_POLYLINE_TOLERANCE_M=6
# 单段折线点数上限（兜底；正常抽稀后远低于此值）
MAP_POLYLINE_MAX_POINTS=400

# ===== 天气 =====
WEATHER_API_KEY=

# ===== 数据库路径（相对 backend/app/ 目录，与启动目录无关）=====
CHROMA_DB_PATH=data/chroma_db
CHECKPOINT_DB_PATH=data/checkpoints/sessions.db

# ===== CORS =====
ALLOWED_ORIGINS=["http://localhost:5173"]

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== MCP 工具运行时 uvx 的绝对路径（留空则自动探测 PATH 与当前虚拟环境）=====
UVX_PATH=

# ===== 景点地理编码失败时的坐标兜底中心 =====
DEFAULT_MAP_LNG=121.6186
DEFAULT_MAP_LAT=38.9146
